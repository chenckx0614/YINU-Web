{
  "id": "./",
  "name": "一隅",
  "short_name": "一隅",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#f3f4f6",
  "icons": [{ "src": "./icon.png", "sizes": "1254x1254", "type": "image/png", "purpose": "any" }],
  "shortcuts": [{ "name": "快速记录", "url": "./?capture=text" }, { "name": "添加文件", "url": "./?capture=files" }],
  "share_target": {
    "action": "./receive-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "audio/*", "video/*", "application/*", "text/*"] }]
    }
  }
}
